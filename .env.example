# =============================================================================
# Pipecat — Environment Variables Reference
# =============================================================================
# Copy this file to `.env` and fill in the keys for the services you want:
#
#     cp .env.example .env
#
# Every key in this file is OPTIONAL. Add only the ones for the providers you
# use. The `# extra:` comments below show the `uv add` command that installs
# the provider SDK for that service (`pipecat-ai[xxx]`).
#
# Core services used by most bots:
#   STT (speech-to-text)  -> 1 key     e.g. OPENAI_API_KEY
#   LLM (chat brain)      -> 1 key     e.g. OPENAI_API_KEY
#   TTS (text-to-speech)  -> 1 key     e.g. OPENAI_API_KEY
# Running with only OPENAI_API_KEY set works out of the box.
# =============================================================================

# ---------------------------------------------------------------------------
# Speech-to-Text (STT)
# ---------------------------------------------------------------------------

# OpenAI Whisper / gpt-4o-transcribe
# extra: (included with base pipecat-ai)
OPENAI_API_KEY=

# Deepgram
# extra: uv add "pipecat-ai[deepgram]"
DEEPGRAM_API_KEY=

# AssemblyAI
# extra: uv add "pipecat-ai[assemblyai]"
ASSEMBLYAI_API_KEY=

# ElevenLabs
# extra: uv add "pipecat-ai[elevenlabs]"
ELEVENLABS_API_KEY=

# Cartesia (STT + TTS)
# extra: uv add "pipecat-ai[cartesia]"
CARTESIA_API_KEY=

# Google / Gemini (STT + LLM + TTS + image)
# extra: uv add "pipecat-ai[google]"
GOOGLE_API_KEY=

# Azure (STT + LLM + TTS + image)
# extra: uv add "pipecat-ai[azure]"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Groq (STT Whisper + LLM + TTS)
# extra: uv add "pipecat-ai[groq]"
GROQ_API_KEY=

# Mistral (STT + LLM + TTS)
# extra: uv add "pipecat-ai[mistral]"
MISTRAL_API_KEY=

# xAI / Grok (STT + LLM)
# extra: uv add "pipecat-ai[xai]"
XAI_API_KEY=

# NVIDIA (STT + LLM + TTS)
# extra: uv add "pipecat-ai[nvidia]"
NVIDIA_API_KEY=

# Sarvam (STT + LLM)
# extra: uv add "pipecat-ai[sarvam]"
SARVAM_API_KEY=

# Together AI (STT + LLM)
# extra: uv add "pipecat-ai[together]"
TOGETHER_API_KEY=

# Soniox
# extra: uv add "pipecat-ai[soniox]"
SONIOX_API_KEY=

# Speechmatics
# extra: uv add "pipecat-ai[speechmatics]"
SPEECHMATICS_API_KEY=

# Gladia (STT + TTS)
# extra: uv add "pipecat-ai[gladia]"
GLADIA_API_KEY=

# Gradium (STT + TTS)
# extra: uv add "pipecat-ai[gradium]"
GRADIUM_API_KEY=

# fal.ai (Wizper STT + image)
# extra: uv add "pipecat-ai[fal]"
FAL_KEY=

# Smallest
# extra: uv add "pipecat-ai[smallest]"
SMALLEST_API_KEY=

# Moonshine (local) — no API key
# extra: uv add "pipecat-ai[moonshine]"

# Whisper (local) — no API key
# extra: uv add "pipecat-ai[whisper]"

# FunASR (local) — no API key
# extra: uv add "pipecat-ai[funasr]"

