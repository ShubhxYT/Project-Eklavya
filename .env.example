# ---------------------------------------------------------------------------
# Text-to-Speech (TTS)
# ---------------------------------------------------------------------------

# OpenAI — included with base pipecat-ai
OPENAI_API_KEY=

# Cartesia — extra: uv add "pipecat-ai[cartesia]"
CARTESIA_API_KEY=
# Optional: override the default voice
CARTESIA_VOICE_ID=

# ElevenLabs — extra: uv add "pipecat-ai[elevenlabs]"
ELEVENLABS_API_KEY=
# Optional: ElevenLabs voice id
ELEVENLABS_VOICE_ID=

# Azure — extra: uv add "pipecat-ai[azure]"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google — extra: uv add "pipecat-ai[google]"
GOOGLE_API_KEY=

# Deepgram — extra: uv add "pipecat-ai[deepgram]"
DEEPGRAM_API_KEY=

# Groq — extra: uv add "pipecat-ai[groq]"
GROQ_API_KEY=

# Voicebox (self-hosted TTS, kokoro engine) — no API key
# extra: none (custom service in voicebox_tts.py)
VOICEBOX_URL=http://192.168.29.102:17600
VOICEBOX_PROFILE=HF Female
VOICEBOX_ENGINE=kokoro

# Drona grounded tutor — answers questions ONLY from the ingested OKF course
# (see tutor/cli.py to ingest). DATA_DIR must match where `tutor ingest` writes.
DATA_DIR=tutor/data
# COURSE_ID=<optional course id; auto-picks if a single course is ingested>
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Rime
# extra: uv add "pipecat-ai[rime]"
RIME_API_KEY=

# PlayHT — extra: uv add "pipecat-ai[playht]" (check available extras)
PLAYHT_API_KEY=
PLAYHT_USER_ID=

# MiniMax
# extra: uv add "pipecat-ai[minimax]"
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Hume
# extra: uv add "pipecat-ai[hume]"
HUME_API_KEY=

# Fish Audio
# extra: uv add "pipecat-ai[fish]"
FISH_API_KEY=
FISH_API_URL=

# LMNT
# extra: uv add "pipecat-ai[lmnt]"
LMNT_API_KEY=

# Neuphonic
# extra: uv add "pipecat-ai[neuphonic]"
NEUPHONIC_API_KEY=

# Camb AI
# extra: uv add "pipecat-ai[camb]"
CAMB_API_KEY=

# Bland
# extra: uv add "pipecat-ai[bland]"
BLAND_API_KEY=

# Async AI
# extra: uv add "pipecat-ai[asyncai]"
ASYNC_API_KEY=

# Kokoro (local) — no API key
# extra: uv add "pipecat-ai[kokoro]"

# Piper (local) — no API key
# extra: uv add "pipecat-ai[piper]"

# Pocket TTS (local) — no API key
# extra: uv add "pipecat-ai[pocket-tts]"

# ---------------------------------------------------------------------------
# Realtime (speech-to-speech) LLMs
# ---------------------------------------------------------------------------

# OpenAI Realtime — extra: uv add "pipecat-ai[openai]"
OPENAI_API_KEY=

# Gemini Live — extra: uv add "pipecat-ai[google]"
GOOGLE_API_KEY=

# Grok Voice Agent — extra: uv add "pipecat-ai[grok]"
XAI_API_KEY=

# Ultravox
# extra: uv add "pipecat-ai[ultravox]"
ULTRAVOX_API_KEY=

# AWS Nova Sonic — extra: uv add "pipecat-ai[aws-nova-sonic]" (uses AWS creds below)

# Inworld (realtime + TTS)
# extra: uv add "pipecat-ai[inworld]"
INWORLD_API_KEY=
INWORLD_WORKSPACE=

# ---------------------------------------------------------------------------
# Cloud providers (shared credentials)
# ---------------------------------------------------------------------------

# AWS (Bedrock LLM, Transcribe STT, Polly TTS, Nova Sonic realtime)
# extra: uv add "pipecat-ai[aws]"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_DEFAULT_REGION=

# Google Cloud (Vertex AI LLM / Gemini Live Vertex)
# extra: uv add "pipecat-ai[google]"
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# ---------------------------------------------------------------------------
# Image generation (processors, not core voice)
# ---------------------------------------------------------------------------
# fal.ai — extra: uv add "pipecat-ai[fal]"
FAL_KEY=
# OpenAI image — extra: uv add "pipecat-ai[openai]"
OPENAI_API_KEY=
# Google image — extra: uv add "pipecat-ai[google]"
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Transports
# ---------------------------------------------------------------------------

# WebRTC (local, default) — extra: uv add "pipecat-ai[webrtc]"
# No key required.

# Daily (WebRTC rooms) — extra: uv add "pipecat-ai[daily]"
DAILY_API_KEY=
DAILY_API_URL=
DAILY_ROOM_URL=

# LiveKit — extra: uv add "pipecat-ai[livekit]"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LIVEKIT_ROOM_NAME=

# Twilio (telephony) — extra: uv add "pipecat-ai[websocket]"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Preferred for production REST calls; keep the Auth Token for Pipecat's
# automatic call hang-up, or leave it blank to let the caller end the stream.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Public HTTPS URL for this bot, without a path (ngrok locally; your service URL
# in production). The corresponding WebSocket URL is generated by the runner.
PIPECAT_PUBLIC_URL=

# Telnyx (telephony) — extra: uv add "pipecat-ai[websocket]"
TELNYX_API_KEY=

# Plivo (telephony) — extra: uv add "pipecat-ai[websocket]"
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Exotel (telephony) — extra: uv add "pipecat-ai[websocket]"
EXOTEL_API_KEY=
EXOTEL_SUBDOMAIN=

# Vonage (video connector) — extra: uv add "pipecat-ai[vonage-video-connector]"
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=

# WhatsApp — extra: uv add "pipecat-ai[webrtc]"
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=

# MoQ — extra: uv add "pipecat-ai[moq]"
# No key required.

