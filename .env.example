# Copy to .env and fill in the keys you use. Everything here is read by the app.

# --- LLM / STT (Groq) -------------------------------------------------------
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b

# --- Grounded course corpus -------------------------------------------------
# Defaults to ./data; the ingest CLI writes OKF bundles under $DATA_DIR/okf.
# DATA_DIR=./data
# COURSE_ID=
# CLIENT_DIR=./client

# --- TTS (self-hosted voicebox) --------------------------------------------
VOICEBOX_URL=http://192.168.29.102:17600
VOICEBOX_PROFILE=HF Female
VOICEBOX_ENGINE=kokoro

# --- Twilio outbound calls (optional) --------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_PHONE_NUMBER=
# PIPECAT_PUBLIC_URL=https://your-public-host.example

# --- Transport / deployment ------------------------------------------------
# PIPECAT_ALLOWED_ORIGINS=https://conv.shubhsomani.tech
# PIPECAT_ICE_SERVERS=[{"urls":["turn:..."],"username":"...","credential":"..."}]

# --- Behavior sensing (vision worker) --------------------------------------
# CV_PYTHON=vision/.venv-h5/bin/python
# CV_MODEL_PATH=vision/daisee_engagement_model_final.h5
# CV_CAMERA_INDEX=0
