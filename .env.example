SENTRY_DSN=

# Koala (audio filter) — extra: uv add "pipecat-ai[koala]"
KOALA_API_KEY=

# Krisp VIVA (audio filter) — extra: uv add "pipecat-ai[krisp]"
KRISP_API_KEY=

