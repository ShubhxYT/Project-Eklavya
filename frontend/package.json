{
  "name": "eklavya-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build:overlay": "vite build -c vite.overlay.config.ts && mkdir -p ../client/models && cp dist-overlay/avatar-overlay.js ../client/ && cp public/models/avatar.glb public/models/animations.glb ../client/models/",
    "typecheck": "tsc --noEmit",
    "dev:learner": "vite -c vite.learner.config.ts",
    "build:learner": "vite build -c vite.learner.config.ts && node learner/scripts/copy-assets.mjs",
    "typecheck:learner": "tsc --noEmit -p tsconfig.learner.json",
    "test:learner": "vitest run -c vitest.learner.config.ts"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "1.13.0",
    "@pipecat-ai/client-react": "1.8.2",
    "@pipecat-ai/small-webrtc-transport": "1.10.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.15.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "3.2.7"
  }
}
